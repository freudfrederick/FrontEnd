{
  "info": {
    "name": "Chronos Pomodoro API",
    "description": "Collection completa da API do Chronos Pomodoro — Fase 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3333" },
    { "key": "token", "value": "" },
    { "key": "reset_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastro",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"freud@iesb\",\n  \"name\": \"Freud Castelo\",\n  \"password\": \"iesb\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retorna token', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.test('Retorna usuario', () => pm.expect(json.user.email).to.eql('freud@iesb'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastro duplicado (deve falhar)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"freud@iesb\",\n  \"name\": \"Freud Castelo\",\n  \"password\": \"iesb\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Mensagem de duplicidade', () => pm.expect(pm.response.json().message).to.include('já cadastrado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"freud@iesb\",\n  \"password\": \"iesb\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna token', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login senha errada (deve falhar)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"freud@iesb\",\n  \"password\": \"errada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensagem de erro', () => pm.expect(pm.response.json().message).to.include('inválidas'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Esqueci minha senha",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/forgot-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"freud@iesb\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.resetToken) pm.collectionVariables.set('reset_token', json.resetToken);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna resetToken (lab)', () => pm.expect(json.resetToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Redefinir senha",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"newPassword\": \"iesb\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Senha redefinida', () => pm.expect(pm.response.json().message).to.include('sucesso'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "GET Settings",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/settings",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tem workTime', () => pm.expect(pm.response.json().workTime).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Settings",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/settings",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workTime\": 25,\n  \"shortBreakTime\": 5,\n  \"longBreakTime\": 15\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('workTime atualizado', () => pm.expect(pm.response.json().workTime).to.eql(25));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Settings sem token (deve falhar)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/settings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "GET Tasks",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Task",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/tasks",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"task-001\",\n  \"name\": \"Estudar JWT\",\n  \"duration\": 25,\n  \"type\": \"workTime\",\n  \"startDate\": 1700000000000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Task criada', () => pm.expect(pm.response.json().id).to.eql('task-001'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Task - Complete",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/tasks/task-001/complete",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completeDate\": 1700003600000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Task concluida', () => pm.expect(pm.response.json().completeDate).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Task - Interrupt",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/tasks/task-001/interrupt",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interruptDate\": 1700003600000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE Tasks (limpar histórico)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/tasks",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
